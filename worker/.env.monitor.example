# ══════════════════════════════════════════════════════════
# Monitor Worker 配置模板
# 复制为 worker\.env 并修改：copy .env.monitor.example .env
# ══════════════════════════════════════════════════════════

# ── 总控连接（必填）───────────────────────────────────────
# 填写总控后端地址
BACKEND_WS_URL=ws://192.168.1.100:8000/api/agent/ws

# ── 浏览器 ──────────────────────────────────────────────
# 首次部署建议 false（有头）确认登录正常，稳定后改为 true（无头）
PLAYWRIGHT_HEADLESS=false

# ── 心跳与重连 (秒) ──────────────────────────────────────
HEARTBEAT_INTERVAL=20
RECONNECT_INTERVAL=5

# ── 对象存储 RustFS（浏览器配置跨机器同步）───────────────
# 填写 RustFS 地址；留空则禁用远程同步（登录态仅本地保留）
STORAGE_ENDPOINT=http://192.168.1.100:9000
STORAGE_BUCKET=auto-uploads
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=

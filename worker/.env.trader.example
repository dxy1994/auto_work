# ══════════════════════════════════════════════════════════
# Trader Worker 配置模板
# 复制为 worker\.env 并修改：copy .env.trader.example .env
# ══════════════════════════════════════════════════════════

# ── 总控连接（必填）───────────────────────────────────────
# 填写总控后端地址
BACKEND_WS_URL=ws://192.168.1.100:8000/api/agent/ws

# ── 心跳与重连 (秒) ──────────────────────────────────────
HEARTBEAT_INTERVAL=20
RECONNECT_INTERVAL=5

# ── ESP32C3 硬件 ─────────────────────────────────────────
# 固件就绪后在 hardware/controller.py 中配置 ESP32 IP
# ESP32_HOST=192.168.1.200

# ── 对象存储 RustFS（预留，Trader 当前不需要）─────────────
STORAGE_ENDPOINT=
# STORAGE_BUCKET=auto-uploads
# STORAGE_ACCESS_KEY=rustfsadmin
# STORAGE_SECRET_KEY=rustfsadmin
# STORAGE_REGION=us-east-1
# STORAGE_PATH_STYLE=true
# STORAGE_PUBLIC_BASE_URL=

# ── 角色（不要修改）───────────────────────────────────────
WORKER_ROLE=trader

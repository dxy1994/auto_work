# ══════════════════════════════════════════════════════════
# Trader Worker 配置模板
# 复制为 worker\.env 并修改：copy .env.trader.example .env
# ══════════════════════════════════════════════════════════

# ── 总控连接（必填）───────────────────────────────────────
# 填写总控后端地址
BACKEND_WS_URL=ws://192.168.1.100:8000/api/agent/ws

# ── 心跳与重连 (秒) ──────────────────────────────────────
HEARTBEAT_INTERVAL=20
RECONNECT_INTERVAL=5

# ── ESP32C3 硬件 ─────────────────────────────────────────
# ESP32 HTTP HID 网关地址（必须提供 /health、/mouse/*、/key/* 接口）
ESP32_HOST=192.168.1.200

# ── 天堂经典版 800x600 服务器列表固定点位 ───────────────
# 两列按 sort_order 交替排列：1左1、2右1、3左2……
LINEAGE_SERVER_LEFT_X=310
LINEAGE_SERVER_RIGHT_X=470
LINEAGE_SERVER_FIRST_Y=154
LINEAGE_SERVER_ROW_PITCH=18.5

# 韩语 OCR 与大区代码匹配的硬门槛（低于门槛一律视为识别失败）
LINEAGE_OCR_MIN_CONFIDENCE=90
LINEAGE_REGION_TEXT_SIMILARITY=0.90

# ── 对象存储 RustFS（预留，Trader 当前不需要）─────────────
STORAGE_ENDPOINT=
# STORAGE_BUCKET=auto-uploads
# STORAGE_ACCESS_KEY=rustfsadmin
# STORAGE_SECRET_KEY=rustfsadmin
# STORAGE_REGION=us-east-1
# STORAGE_PATH_STYLE=true
# STORAGE_PUBLIC_BASE_URL=

# ── 角色（不要修改）───────────────────────────────────────
WORKER_ROLE=trader

# ══════════════════════════════════════════════════════════
# 游戏执行 Worker 配置模板
# 复制为 worker\.env 并修改：copy .env.game-executor.example .env
# ══════════════════════════════════════════════════════════

# ── 总控连接（必填）───────────────────────────────────────
# 填写总控后端地址
BACKEND_WS_URL=ws://192.168.1.24:8000/api/agent/ws

# ── 游戏识别图片下载地址（可选）────────────────────────────
# 总控下发 /uploads/... 相对路径；这里填写能够访问该路径的总控后端根地址。
# 仅在未配置下方 RustFS 直连时使用；留空会从 BACKEND_WS_URL 自动推导。
GAME_IMAGE_BASE_URL=http://192.168.1.24:8000

# ── RustFS 物品识别图片直连（游戏机读取）───────────────────
# /uploads/images/xxx.png 会转换为 auto-uploads 桶中的 images/xxx.png。
STORAGE_ENDPOINT=http://192.168.1.24:9000
STORAGE_BUCKET=auto-uploads
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true

# ── 心跳与重连 (秒) ──────────────────────────────────────
HEARTBEAT_INTERVAL=20
RECONNECT_INTERVAL=5

# 服务器断线弹窗守护（秒 / 连续命中次数；次数最低为 2）
GAME_DISCONNECT_POLL_SECONDS=3
GAME_DISCONNECT_CONFIRMATIONS=2

# 韩语 OCR 与大区代码匹配的硬门槛（低于门槛一律视为识别失败）
# 大区点击坐标由总控随交易指令下发；未配置时执行机使用 OCR 定位。
LINEAGE_OCR_MIN_CONFIDENCE=90
LINEAGE_REGION_TEXT_SIMILARITY=0.90

# 从 Wireless HID 截图接口等待一帧游戏画面的最长时间（秒，最低 1 秒）
# 内网较慢或截图设备响应不稳定时可适当调大。
LINEAGE_CAPTURE_TIMEOUT_SECONDS=5

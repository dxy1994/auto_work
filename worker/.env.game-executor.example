# ══════════════════════════════════════════════════════════
# 游戏执行 Worker 配置模板
# 复制为 worker\.env 并修改：copy .env.game-executor.example .env
# ══════════════════════════════════════════════════════════

# ── 总控连接（必填）───────────────────────────────────────
# 填写总控后端地址
BACKEND_WS_URL=ws://192.168.1.100:8000/api/agent/ws

# ── 心跳与重连 (秒) ──────────────────────────────────────
HEARTBEAT_INTERVAL=20
RECONNECT_INTERVAL=5

# ── ESP32C3 硬件 ─────────────────────────────────────────
# ESP32 HTTP HID 网关地址（必须提供 /health、/mouse/*、/key/* 接口）
ESP32_HOST=192.168.1.200

# 韩语 OCR 与大区代码匹配的硬门槛（低于门槛一律视为识别失败）
# 大区点击坐标由总控随交易指令下发；未配置时执行机使用 OCR 定位。
LINEAGE_OCR_MIN_CONFIDENCE=90
LINEAGE_REGION_TEXT_SIMILARITY=0.90

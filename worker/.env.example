# 总控 Agent WebSocket 接入点（改成总控机器的 IP/端口）
BACKEND_WS_URL=ws://127.0.0.1:8000/api/agent/ws

# 是否无头运行浏览器（无人值守机器可设 true）
PLAYWRIGHT_HEADLESS=false

# 心跳间隔（秒）
HEARTBEAT_INTERVAL=20

# 断线重连间隔（秒）
RECONNECT_INTERVAL=5

# ── RustFS / S3 兼容存储（浏览器配置跨机器同步，留空则不启用）──
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=auto-worker-profiles
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true
